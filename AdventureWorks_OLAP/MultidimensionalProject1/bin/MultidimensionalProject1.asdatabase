          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Volumen Total]
 AS [Measures].[Order Quantity - Fact Internet Sales] + [Measures].[Order Quantity], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Rentabilidad Internet]
 AS [Measures].[Sales Amount - Fact Internet Sales] - [Measures].[Total Product Cost - Fact Internet Sales], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Rentabilidad Reseller]
 AS [Measures].[Sales Amount - Total Product Cost], 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
